# Anthropic — scores the photos
ANTHROPIC_API_KEY=sk-ant-...

# Supabase. Locally these come from `supabase status`; hosted, from the
# project's API settings. Only the service-role key is needed — every write
# goes through a route handler, so the browser never talks to Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anything random and long. Signs the player session cookie.
SESSION_SECRET=change-me-to-32-plus-random-chars

# Typed on the join screen before picking a name.
PARTY_CODE=BYEMATT

# The groom's display name. Only a label — it's what the sign-in button says
# and what shows in the feed. He presses that button rather than typing a name,
# so nothing depends on him spelling it a particular way. Defaults to "Matt".
TARGET_NAME=Matt

# Web push. Run `pnpm vapid` and paste the pair below — it's how Apple, Google
# and Mozilla's push services know the alerts came from this server. Leave them
# blank and the game plays exactly as before, just without the buzz.
#
# Don't rotate these mid-party: every phone that opted in is subscribed to the
# old public key and goes silent until it re-subscribes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address for whoever runs the party, in case a push service needs to
# complain about the traffic. Nobody checks it.
VAPID_SUBJECT=mailto:you@example.com
